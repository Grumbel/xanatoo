[Desktop Entry]
Type=Application
Name=xanatoo
GenericName=Document Editor
Comment=Interactive hypertext document editor and browser
Exec=xanatoo %F
Icon=xanatoo
Terminal=false
Categories=Office;WordProcessor;
Keywords=markdown;org;gemini;hypertext;notes;editor;browser;
MimeType=text/markdown;text/x-markdown;text/org;text/gemini;
StartupWMClass=xanatoo
SingleMainWindow=true
