;; SPDX-License-Identifier: GPL-3.0-or-later
;; Editorial — spacious, contemporary magazine layout for articles and threads.
(stylesheet
  (name "Editorial")
  (description "Crisp typography, airy threads, restrained indigo accents")
  (define ink "#273344")
  (define muted "#637386")
  (define accent "#375f9c")
  (define line "#d7dfe7")
  (page (background "#f9fafb") (color ink)
        (selection (rgba 87 131 190 100))
        (mark (rgba 255 200 89 100)))
  (fonts (body "Inter" "Source Sans 3" "Noto Sans" "DejaVu Sans" "sans-serif")
         (heading "Source Serif 4" "Libertinus Serif" "Charter" "DejaVu Serif")
         (heading-scale 1.52)
         (code "JetBrains Mono" "DejaVu Sans Mono" "monospace"))
  (role paragraph (space-after 0.94em))
  (role header (color "#1d2939") (space-before 1.12em) (space-after 0.48em))
  (role section (space-before 0.52em) (space-after 0.64em) (indent 0))
  (role list-item (space-after 0.4em))
  (role block-quote (indent 1.2em) (color "#526478") (border "#8ca9c9"))
  (role note (indent 1.1em) (border "#c48a45") (background "#fff9ed"))
  (role code-block (background "#eef2f6") (border line) (indent 0.8em))
  (role thread (color "#1d2939") (space-before 1em) (space-after 1.3em)
               (border "#adc1d7"))
  (role message (font small) (space-before 0.42em) (space-after 1.1em)
                (border "#aabbd0") (background "#ffffff"))
  (role message-alt (background "#f2f6fa"))
  (role message-author (color "#2b5795"))
  (role message-op (color "#a25932"))
  (role message-meta (color muted))
  (role caption (font small) (color muted))
  (role metadata (font small) (color muted))
  (role table (border line) (background "#eaf0f6"))
  (role rule (border line) (space-before 1em) (space-after 1em))
  (role aside (color "#475569") (background "#f0f4f8") (border line))
  (role link (color accent) (underline #t))
  (role cite (color "#73539b"))
  (role code (color "#9e4b38") (background "#edf1f6")))
