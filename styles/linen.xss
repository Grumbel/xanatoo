;; SPDX-License-Identifier: GPL-3.0-or-later
;; Linen — soft paper and a restrained typographic hierarchy.
(stylesheet
  (name "Linen")
  (description "Calm long-form reading with warmer paper and generous breathing room")
  (define paper "#faf5e9")
  (define ink "#3c382f")
  (define accent "#806142")
  (define line "#d7c8af")
  (page (background paper) (color ink)
        (selection (rgba 204 172 119 115)))
  (fonts (body "Charter" "Source Serif 4" "Libertinus Serif" "Noto Serif" "DejaVu Serif" "serif")
         (heading "Source Serif 4" "Charter" "Libertinus Serif" "DejaVu Serif")
         (heading-weight regular) (heading-scale 1.62)
         (code "IBM Plex Mono" "DejaVu Sans Mono" "monospace"))
  (role paragraph (space-after 1.02em))
  (role header (color "#594333") (space-before 1.22em) (space-after 0.55em))
  (role section (indent 0) (space-before 0.55em) (space-after 0.8em))
  (role list-item (space-after 0.4em))
  (role block-quote (indent 1.1em) (color "#625b4d") (border "#b6a48b"))
  (role note (background "#f4ead6") (border "#b68a52"))
  (role code-block (background "#f1e8d8") (border line))
  (role thread (color "#594333") (space-before 1em) (space-after 1.5em))
  (role message (font small) (space-before 0.4em) (space-after 1.18em)
                (border "#c1ab8e") (background "#fffaf0"))
  (role message-alt (background "#f1e9db"))
  (role message-author (color "#855c3a"))
  (role message-op (color "#7f5669"))
  (role message-meta (color "#83776a"))
  (role caption (color "#83776a"))
  (role metadata (font small) (color "#83776a"))
  (role aside (background "#f2e9d7") (border line) (color "#625849"))
  (role table (background "#efe4d1") (border line))
  (role rule (border line))
  (role link (color accent) (underline #t))
  (role cite (color "#79576e"))
  (role code (color "#76533d") (background "#efe4d1")))
