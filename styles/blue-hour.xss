;; SPDX-License-Identifier: GPL-3.0-or-later
;; Blue Hour — low-glare, legible dark theme with soft contrast.
(stylesheet
  (name "Blue Hour")
  (description "Blue-black canvas, gentle contrast, understated cyan links")
  (define paper "#18212d")
  (define ink "#dbe5ec")
  (define muted "#9bacbe")
  (define line "#37495b")
  (define accent "#91c5eb")
  (page (background paper) (color ink)
        (selection (rgba 80 154 215 100)))
  (fonts (body "Inter" "Noto Sans" "Source Sans 3" "DejaVu Sans" "sans-serif")
         (heading "Source Sans 3" "Noto Sans" "DejaVu Sans")
         (heading-scale 1.5)
         (code "JetBrains Mono" "DejaVu Sans Mono" "monospace"))
  (role paragraph (space-after 0.85em))
  (role header (color "#f0f6fa") (space-before 1.1em) (space-after 0.5em))
  (role section (indent 0) (space-after 0.7em))
  (role block-quote (color "#c1ccd6") (border "#5c839e"))
  (role note (color "#e0d0b9") (background "#30303a") (border "#ac9468"))
  (role code-block (background "#222e3c") (border line))
  (role thread (color "#f0f6fa") (space-before 0.8em) (space-after 1.2em)
               (border "#53748e"))
  (role message (font small) (space-before 0.4em) (space-after 1.06em)
                (background "#23303e") (border "#547c9b"))
  (role message-alt (background "#283849"))
  (role message-author (color "#9ecbf0"))
  (role message-op (color "#e1b27e"))
  (role message-meta (color muted))
  (role metadata (font small) (color muted))
  (role caption (color muted))
  (role aside (background "#263545") (color "#c5d4df") (border line))
  (role table (background "#293748") (border line))
  (role rule (border line))
  (role link (color accent) (underline #t))
  (role cite (color "#cbb5f4"))
  (role code (color "#eec09c") (background "#273748")))
