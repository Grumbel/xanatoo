;; SPDX-License-Identifier: GPL-3.0-or-later
;; Forum — compact-but-readable discussion view with clearly separated cards.
(stylesheet
  (name "Forum")
  (description "Discussion-first design: readable cards, generous thread gaps")
  (define ink "#263342")
  (define blue "#3669a2")
  (define rule "#d9e2e9")
  (page (background "#edf2f5") (margin-background "#d8e1e8")
        (color ink) (selection (rgba 74 141 203 105)))
  (fonts (body "Source Sans 3" "Inter" "Noto Sans" "DejaVu Sans" "sans-serif")
         (heading "Source Sans 3" "DejaVu Sans" "sans-serif")
         (heading-scale 1.4)
         (code "IBM Plex Mono" "DejaVu Sans Mono" "monospace"))
  (role article (space-before 1.15em) (space-after 1.15em))
  (role paragraph (space-after 0.68em))
  (role heading (color "#192b3c") (space-before 0.8em) (space-after 0.45em))
  (role section (indent 0) (space-before 0.35em) (space-after 0.5em))
  (role thread (background "#dbe8f2") (color "#214664")
               (space-before 0.8em) (space-after 1.4em) (border "#b6cede"))
  (role message (font small) (space-before 0.4em) (space-after 1.18em)
                (border "#a6bfd1") (background "#ffffff"))
  (role message-alt (background "#f4f7fa"))
  (role message-author (color blue))
  (role message-op (color "#a56030"))
  (role message-meta (color "#647a89"))
  (role metadata (font small) (color "#647a89"))
  (role block-quote (border "#b1c1cd") (color "#64717f"))
  (role code-block (background "#e9eff3") (border rule))
  (role table (border rule) (background "#e9eff5"))
  (role rule (border rule))
  (role aside (background "#e6eef4") (border rule))
  (role link (color blue) (underline #t))
  (role code (color "#9b4c35") (background "#e9eff3")))
